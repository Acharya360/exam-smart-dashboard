    {
      "id": "complete",
      "lane": "primary",
      "col": 4,
      "width": 92,
      "type": "frontend",
      "label": "Complete",
      "sublabel": "with notes"
    },
    {
      "id": "escalate",
      "lane": "recovery",
      "col": 5,
      "width": 112,
      "type": "security",
      "label": "Escalate",
      "sublabel": "rationale required"
    },
    {
      "id": "enforce",
      "lane": "system",
      "col": 5,
      "width": 112,
      "type": "security",
      "label": "Enforce Rules",
      "sublabel": "PATCH /api/tasks"
    },
    {
      "id": "resume",
      "lane": "recovery",
      "col": 4,
      "width": 92,
      "type": "frontend",
      "label": "Resume",
      "sublabel": "banner alert"
    },
    {
      "id": "alerts",
      "lane": "superadmin",
      "col": 5,
      "width": 110,
      "type": "frontend",
      "label": "Critical Alerts",
      "sublabel": "COE oversight"
    }
  ],
  "edges": [
    {
      "from": "upload",
      "to": "parse",
      "label": "xlsx / xls"
    },
    {
      "from": "parse",
      "to": "commit",
      "label": "valid rows"
    },
    {
      "from": "commit",
      "to": "gen4",
      "label": "auto-generate"
    },
    {
      "from": "gen4",
      "to": "start",
      "label": "4 milestones"
    },
    {
      "from": "start",
      "to": "complete",
      "label": "on track",
      "variant": "emphasis"
    },
    {
      "from": "start",
      "to": "escalate",
      "label": "blocked / overdue",
      "variant": "security"
    },
    {
      "from": "escalate",
      "to": "enforce",
      "label": "rationale",
      "variant": "security",
      "fromSide": "top"
    },
    {
      "from": "enforce",
      "to": "resume",
      "label": "reassign + stamp",
      "variant": "security"
    },
    {
      "from": "resume",
      "to": "complete",
      "label": "resumes execution",
      "role": "return"
    },
    {
      "from": "enforce",
      "to": "alerts",
      "label": "escalated + overdue",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "4-Phase Task Suite",
      "items": [
        "Question Paper Printing & Secure Vault Packaging",
        "Hall Seating Plan, Attendance Sheets & Roll Labels",
        "Invigilation Duty Assignment & Verification",
        "Answer Booklet Collection & Counterfoil Verification"
      ]
    },
    {
      "dot": "amber",
      "title": "Escalation Enforcement",
      "items": [
        "Server rejects escalation without a rationale",
        "assigned_to becomes the alternate; escalated_at stamped",
        "Alternate resumes; COE sees Critical Alerts"
      ]
    }
  ]
}
