      {
        "from": "escalate",
        "to": "enforce"
      },
      {
        "from": "enforce",
        "to": "resume"
      }
    ],
    "requiredPaths": [
      {
        "from": "upload",
        "to": "complete"
      }
    ]
  },
  "nodes": [
    {
      "id": "upload",
      "lane": "superadmin",
      "col": 0,
      "width": 96,
      "type": "frontend",
      "label": "Upload Excel",
      "sublabel": "timetable workbook"
    },
    {
      "id": "parse",
      "lane": "system",
      "col": 1,
      "width": 116,
      "type": "backend",
      "label": "Parse + Validate",
      "sublabel": "SheetJS headers"
    },
    {
      "id": "commit",
      "lane": "system",
      "col": 2,
      "width": 92,
      "type": "backend",
      "label": "Commit",
      "sublabel": "rows + auto-gen"
    },
    {
      "id": "gen4",
      "lane": "system",
      "col": 3,
      "width": 96,
      "type": "backend",
      "label": "4-Phase Suite",
      "sublabel": "per schedule",
      "tag": "idempotent"
    },
    {
      "id": "start",
      "lane": "primary",
      "col": 3,
      "width": 92,
      "type": "frontend",
      "label": "Start Task",
      "sublabel": "→ IN_PROGRESS"
