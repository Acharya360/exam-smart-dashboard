{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ExamTrack Examination Task Lifecycle",
    "locale": "en",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "superadmin",
      "label": "Super Admin (COE · DYCOE · ACOE)"
    },
    {
      "id": "system",
      "label": "ExamTrack System · Local SQL Server"
    },
    {
      "id": "primary",
      "label": "Primary Coordinator"
    },
    {
      "id": "recovery",
      "label": "Escalation → Alternate Coordinator",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "ingest",
      "label": "Ingest",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "generate",
      "label": "Generate + Dispatch",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "execute",
      "label": "Execute",
      "fromCol": 4,
      "toCol": 4
    },
    {
      "id": "escalate",
      "label": "Escalate + Recover",
      "fromCol": 5,
      "toCol": 5,
      "variant": "security"
    }
  ],
  "mainPath": [
    "upload",
    "parse",
    "commit",
    "gen4",
    "start",
    "complete"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "upload"
    ],
    "allowedTerminals": [
      "complete",
      "alerts"
    ],
