# ==============================================================================
# PentAGI Autonomous Security Agent - Environment Configuration
# ==============================================================================

# Core image tags (VXControl)
PENTAGI_IMAGE=vxcontrol/pentagi:latest
PGVECTOR_IMAGE=vxcontrol/pgvector:latest
SCRAPER_IMAGE=vxcontrol/scraper:latest

# Web UI & API Binding
PENTAGI_LISTEN_IP=127.0.0.1
PENTAGI_LISTEN_PORT=8443
DEBUG=false

# Security & Session Token Encryption
# Required: 32+ character random string (auto-generated by start-pentagi.ps1)
COOKIE_SIGNING_SALT=replace_with_32_character_random_salt

# PentAGI Database Storage Credentials
PENTAGI_POSTGRES_USER=postgres
PENTAGI_POSTGRES_PASSWORD=replace_with_secure_db_password
PENTAGI_POSTGRES_DB=pentagi

# ------------------------------------------------------------------------------
# LLM Provider Configuration: Google Gemini (OpenAI-compatible Endpoint)
# ------------------------------------------------------------------------------
# Google Gemini API key obtained from Google AI Studio (https://aistudio.google.com/)
OPENAI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI-compatible API base URL for Gemini models
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Default Gemini model used by PentAGI agents
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
OPENAI_MODEL=gemini-2.5-flash

# Optional: Anthropic Claude API Key (if switching to Claude models)
ANTHROPIC_API_KEY=
